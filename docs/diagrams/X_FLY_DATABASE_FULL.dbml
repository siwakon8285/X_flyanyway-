  - hold_extras_passenger_ordinal_check: CHECK (passenger_ordinal >= 1)
  - hold_extras_product_code_check: CHECK (product_code ~ '^[A-Z0-9_]+$'::text)
  - hold_extras_quantity_check: CHECK (quantity = 1)
  - hold_extras_unit_price_amount_check: CHECK (unit_price_amount >= 0)
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - idx_hold_extras_one_baggage_per_passenger: CREATE UNIQUE INDEX idx_hold_extras_one_baggage_per_passenger ON public.hold_extras USING btree (seat_hold_id, passenger_ordinal) WHERE (category = 'BAGGAGE'::text)
  - idx_hold_extras_one_meal_per_passenger: CREATE UNIQUE INDEX idx_hold_extras_one_meal_per_passenger ON public.hold_extras USING btree (seat_hold_id, passenger_ordinal) WHERE (category = 'MEAL'::text)
  '''
}

Table booking_confirmation_email_outbox {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  payment_attempt_id uuid [not null]
  notification_type text [not null, default: `'BOOKING_CONFIRMATION'::text`]
  recipient_email text [not null]
  locale text [not null]
  status text [not null, default: `'PENDING'::text`]
  attempt_count smallint [not null, default: 0]
  next_attempt_at timestamptz [not null, default: `now()`]
  lease_until timestamptz
  provider_message_id text
  last_error_code text
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_attempt_id, notification_type) [unique, name: 'booking_confirmation_email_ou_payment_attempt_id_notificati_key']
  }

  Note: '''
  Role: Historical/retired booking-confirmation email persistence.
  Historical/retired persistence; not part of the active customer flow.
  Named unique constraints:
  - booking_confirmation_email_ou_payment_attempt_id_notificati_key: UNIQUE (payment_attempt_id, notification_type)
  PostgreSQL CHECK constraints:
  - booking_confirmation_email_outbox_attempt_count_check: CHECK (attempt_count >= 0 AND attempt_count <= 6)
  - booking_confirmation_email_outbox_check: CHECK ((status = 'SENT'::text) = (sent_at IS NOT NULL))
  - booking_confirmation_email_outbox_locale_check: CHECK (locale = ANY (ARRAY['EN'::text, 'TH'::text]))
  - booking_confirmation_email_outbox_notification_type_check: CHECK (notification_type = 'BOOKING_CONFIRMATION'::text)
  - booking_confirmation_email_outbox_recipient_email_check: CHECK (length(btrim(recipient_email)) > 0)
  - booking_confirmation_email_outbox_status_check: CHECK (status = ANY (ARRAY['PENDING'::text, 'IN_FLIGHT'::text, 'SENT'::text, 'PERMANENTLY_FAILED'::text]))
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - idx_booking_confirmation_email_outbox_due: CREATE INDEX idx_booking_confirmation_email_outbox_due ON public.booking_confirmation_email_outbox USING btree (next_attempt_at) WHERE (status = ANY (ARRAY['PENDING'::text, 'IN_FLIGHT'::text]))
  '''
}

Table _sqlx_migrations {
  version bigint [pk, not null]
  description text [not null]
  installed_on timestamptz [not null, default: `now()`]
  success boolean [not null]
  checksum bytea [not null]
  execution_time bigint [not null]

  Note: '''
  Role: SQLx migration ledger; not a business-domain table.
  PostgreSQL extensions verified: pgcrypto and pg_trgm; plpgsql is installed.
  '''
}

