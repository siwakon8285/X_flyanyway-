}

Table staff_users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email text [not null, unique]
  password_hash text [not null]
  status text [not null, default: `'ACTIVE'::text`]
  disabled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Role: Staff authentication identity.
  Password hash only; plaintext password is not persisted.
  SYSTEM_ADMIN is an explicit RBAC role, not an implicit universal application superuser.
  Named unique constraints:
  - staff_users_email_key: UNIQUE (email)
  PostgreSQL CHECK constraints:
  - staff_users_check: CHECK ((status = 'ACTIVE'::text) = (disabled_at IS NULL))
  - staff_users_email_check: CHECK (email = lower(btrim(email)))
  - staff_users_email_check1: CHECK (length(email) >= 3 AND length(email) <= 254)
  - staff_users_email_check2: CHECK (POSITION(('@'::text) IN (email)) > 1)
  - staff_users_password_hash_check: CHECK (length(password_hash) > 0)
  - staff_users_status_check: CHECK (status = ANY (ARRAY['ACTIVE'::text, 'DISABLED'::text]))
  '''
}

