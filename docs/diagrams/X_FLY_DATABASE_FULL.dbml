Project XFlyAnyway {
  database_type: 'PostgreSQL'
  Note: 'Current physical PostgreSQL data model for X-Fly Anyway.'
}

Table supported_countries {
  code text [pk, not null]
  name text [not null, unique]

  Note: '''
  Role: Reference/master supported-country data.
  Curated supported-network master.
  Named unique constraints:
  - supported_countries_name_key: UNIQUE (name)
  PostgreSQL CHECK constraints:
  - supported_countries_code_check: CHECK (code ~ '^[A-Z]{2}$'::text)
  - supported_countries_name_check: CHECK (length(btrim(name)) > 0)
  '''
}

Table airports {
  code text [pk, not null]
  name text [not null]
  city text [not null]
  country_code text [not null]
  time_zone text [not null]
  is_primary boolean [not null, default: false]

  Note: '''
  Role: Reference/master airport network data.
  Airport network master is linked to supported_countries by a physical FK.
  PostgreSQL CHECK constraints:
  - airports_city_check: CHECK (length(btrim(city)) > 0)
  - airports_code_check: CHECK (code ~ '^[A-Z]{3}$'::text)
  - airports_country_code_check: CHECK (country_code ~ '^[A-Z]{2}$'::text)
  - airports_name_check: CHECK (length(btrim(name)) > 0)
  - airports_time_zone_check: CHECK (length(btrim(time_zone)) > 0)
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - airports_one_primary_per_country_idx: CREATE UNIQUE INDEX airports_one_primary_per_country_idx ON public.airports USING btree (country_code) WHERE is_primary
  - airports_primary_search_idx: CREATE INDEX airports_primary_search_idx ON public.airports USING btree (city, name, code) WHERE is_primary
  '''
}

Table flight_services {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  public_id text [not null, unique]
  flight_number text [not null, unique]
  origin_code text [not null]
  destination_code text [not null]
  aircraft_code text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  departure_time time
  arrival_time time
  arrival_day_offset smallint
  duration_minutes smallint
  stops text
  origin_time_zone text
  status text [not null, default: `'SCHEDULED'::text`]
  operating_date date
  version bigint [not null, default: 1]
  cancelled_at timestamptz

  indexes {
    (operating_date, flight_number) [name: 'flight_services_management_list_idx']
  }

  Note: '''
  Role: Flight configuration and scheduled service data.
  Active new-customer sales use Business and First; Economy and Premium Economy values remain for historical compatibility.
  origin_code and destination_code are validated airport-code text values but have no physical FK to airports.
  aircraft_code is not physically FK-bound to aircraft_seat_templates.
  Named unique constraints:
  - flight_services_flight_number_key: UNIQUE (flight_number)
  - flight_services_public_id_key: UNIQUE (public_id)
  PostgreSQL CHECK constraints:
  - flight_services_arrival_day_offset_check: CHECK (arrival_day_offset = ANY (ARRAY[0, 1]))
  - flight_services_cancellation_complete: CHECK ((status = 'CANCELLED'::text) = (cancelled_at IS NOT NULL))
  - flight_services_check: CHECK (origin_code <> destination_code)
  - flight_services_destination_code_check: CHECK (destination_code ~ '^[A-Z]{3}$'::text)
  - flight_services_duration_minutes_check: CHECK (duration_minutes > 0)
  - flight_services_origin_code_check: CHECK (origin_code ~ '^[A-Z]{3}$'::text)
  - flight_services_status_check: CHECK (status = ANY (ARRAY['SCHEDULED'::text, 'CANCELLED'::text]))
  - flight_services_stops_check: CHECK (stops = ANY (ARRAY['DIRECT'::text, 'ONE_STOP'::text]))
  - flight_services_version_check: CHECK (version > 0)
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - flight_services_management_list_idx: CREATE INDEX flight_services_management_list_idx ON public.flight_services USING btree (operating_date DESC NULLS LAST, flight_number)
  - flight_services_public_search_idx: CREATE INDEX flight_services_public_search_idx ON public.flight_services USING btree (origin_code, destination_code, operating_date, status) WHERE (status = 'SCHEDULED'::text)
  '''
}

Table flight_service_cabins {
  flight_service_id uuid [not null]
  cabin text [not null]
  base_fare_amount bigint
  currency_code text

  indexes {
    (flight_service_id, cabin) [pk, name: 'flight_service_cabins_pkey']
  }

  Note: '''
  Role: Per-service cabin configuration and fare data.
  Schema CHECK permits all four cabin labels for historical compatibility; current new-sale flow uses Business and First.
  PostgreSQL CHECK constraints:
  - flight_service_cabin_fare_complete: CHECK (base_fare_amount IS NULL AND currency_code IS NULL OR base_fare_amount IS NOT NULL AND currency_code IS NOT NULL)
  - flight_service_cabins_base_fare_amount_check: CHECK (base_fare_amount > 0)
  - flight_service_cabins_cabin_check: CHECK (cabin = ANY (ARRAY['economy'::text, 'premium-economy'::text, 'business'::text, 'first'::text]))
  - flight_service_cabins_currency_code_check: CHECK (currency_code ~ '^[A-Z]{3}$'::text)
  '''
}

Table aircraft_seat_templates {
  aircraft_code text [not null]
  seat_number text [not null]
  row_number smallint [not null]
  column_code text [not null]
  cabin text [not null]
  position text [not null]
  sellable boolean [not null, default: true]

  indexes {
    (aircraft_code, cabin, seat_number) [pk, name: 'aircraft_seat_templates_pkey']
  }

  Note: '''
  Role: Shared aircraft seat-template geometry.
  No separate aircraft master table exists in the physical schema.
  PostgreSQL CHECK constraints:
  - aircraft_seat_templates_cabin_check: CHECK (cabin = ANY (ARRAY['economy'::text, 'premium-economy'::text, 'business'::text, 'first'::text]))
  - aircraft_seat_templates_column_code_check: CHECK (column_code ~ '^[A-Z]+$'::text)
  - aircraft_seat_templates_position_check: CHECK ("position" = ANY (ARRAY['window'::text, 'middle'::text, 'aisle'::text]))
  - aircraft_seat_templates_row_number_check: CHECK (row_number > 0)
  - aircraft_seat_templates_seat_number_check: CHECK (seat_number ~ '^[1-9][0-9]*[A-Z]+$'::text)
  '''
}

Table flight_service_seat_templates {
  flight_service_id uuid [not null]
  seat_number text [not null]
  row_number smallint [not null]
  column_code text [not null]
  cabin text [not null]
  position text [not null]
  sellable boolean [not null, default: true]

  indexes {
    (flight_service_id, cabin, seat_number) [pk, name: 'flight_service_seat_templates_pkey']
  }

  Note: '''
  Role: Per-service managed seat-template geometry.
  PostgreSQL CHECK constraints:
  - flight_service_seat_templates_cabin_check: CHECK (cabin = ANY (ARRAY['business'::text, 'first'::text]))
  - flight_service_seat_templates_column_code_check: CHECK (column_code ~ '^[A-Z]+$'::text)
  - flight_service_seat_templates_position_check: CHECK ("position" = ANY (ARRAY['window'::text, 'middle'::text, 'aisle'::text]))
  - flight_service_seat_templates_row_number_check: CHECK (row_number > 0)
  - flight_service_seat_templates_seat_number_check: CHECK (seat_number ~ '^[1-9][0-9]*[A-Z]+$'::text)
  '''
}

Table flight_instances {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  flight_service_id uuid [not null]
  departure_date date [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (flight_service_id, departure_date) [unique, name: 'flight_instances_flight_service_id_departure_date_key']
    (departure_date, flight_service_id) [name: 'idx_flight_instances_executive_departures']
    (flight_service_id, departure_date) [name: 'idx_flight_instances_service_date']
  }

  Note: '''
  Role: Materialized runtime flight inventory instances.
  Named unique constraints:
  - flight_instances_flight_service_id_departure_date_key: UNIQUE (flight_service_id, departure_date)
  '''
}

Table flight_seats {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  flight_instance_id uuid [not null]
  seat_number text [not null]
  row_number smallint [not null]
  column_code text [not null]
  cabin text [not null]
  position text [not null]
  sellable boolean [not null, default: true]
  booking_status text [not null, default: `'AVAILABLE'::text`]
  hold_id uuid
  booked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (flight_instance_id, cabin, seat_number) [unique, name: 'flight_seats_flight_instance_id_cabin_seat_number_key']
    (flight_instance_id, cabin, seat_number) [name: 'idx_flight_seats_inventory']
  }

  Note: '''
  Role: Materialized runtime seat inventory.
  Named unique constraints:
  - flight_seats_flight_instance_id_cabin_seat_number_key: UNIQUE (flight_instance_id, cabin, seat_number)
  PostgreSQL CHECK constraints:
  - flight_seats_booking_status_check: CHECK (booking_status = ANY (ARRAY['AVAILABLE'::text, 'BOOKED'::text]))
  - flight_seats_cabin_check: CHECK (cabin = ANY (ARRAY['economy'::text, 'premium-economy'::text, 'business'::text, 'first'::text]))
  - flight_seats_check: CHECK (booking_status <> 'BOOKED'::text OR hold_id IS NULL AND booked_at IS NOT NULL)
  - flight_seats_check1: CHECK (booking_status <> 'AVAILABLE'::text OR booked_at IS NULL)
  - flight_seats_column_code_check: CHECK (column_code ~ '^[A-Z]+$'::text)
  - flight_seats_position_check: CHECK ("position" = ANY (ARRAY['window'::text, 'middle'::text, 'aisle'::text]))
  - flight_seats_row_number_check: CHECK (row_number > 0)
  - flight_seats_seat_number_check: CHECK (seat_number ~ '^[1-9][0-9]*[A-Z]+$'::text)
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - idx_flight_seats_hold_id: CREATE INDEX idx_flight_seats_hold_id ON public.flight_seats USING btree (hold_id) WHERE (hold_id IS NOT NULL)
  '''
}

Table seat_holds {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  flight_instance_id uuid [not null]
  cabin text [not null]
  adults smallint [not null]
  children smallint [not null]
  infants smallint [not null]
  access_token_hash bytea [not null]
  expires_at timestamptz [not null]
  released_at timestamptz
  consumed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  extras_saved_at timestamptz
  booking_contact_required boolean [not null, default: true]
  passenger_details_saved_at timestamptz

  Note: '''
  Role: Temporary customer booking state.
  No customer account/login table exists; customer access is hold-token based during booking.
  Schema retains legacy cabin values; current new booking boundaries allow Business and First.
  PostgreSQL CHECK constraints:
  - seat_holds_access_token_hash_check: CHECK (octet_length(access_token_hash) = 32)
  - seat_holds_adults_check: CHECK (adults >= 1)
  - seat_holds_cabin_check: CHECK (cabin = ANY (ARRAY['economy'::text, 'premium-economy'::text, 'business'::text, 'first'::text]))
  - seat_holds_check: CHECK (released_at IS NULL OR consumed_at IS NULL)
  - seat_holds_children_check: CHECK (children >= 0)
  - seat_holds_infants_check: CHECK (infants >= 0)
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - idx_seat_holds_active_expiry: CREATE INDEX idx_seat_holds_active_expiry ON public.seat_holds USING btree (expires_at) WHERE ((released_at IS NULL) AND (consumed_at IS NULL))
  '''
}

Table hold_passengers {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  seat_hold_id uuid [not null]
  ordinal smallint [not null]
  passenger_type text [not null]
  title text [not null]
  given_name text [not null]
  middle_name text
  family_name text [not null]
  date_of_birth date [not null]
  gender text [not null]
  nationality_code text [not null]
  passport_number text [not null]
  passport_issuing_country_code text [not null]
  passport_issue_date date
  passport_expiry_date date
  email text
  phone_country_code text
  phone_number text
  emergency_contact_name text
  emergency_contact_relationship text
  emergency_contact_phone_country_code text
  emergency_contact_phone_number text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (seat_hold_id, ordinal) [unique, name: 'hold_passengers_seat_hold_id_ordinal_key']
    (seat_hold_id, passport_number) [unique, name: 'hold_passengers_seat_hold_id_passport_number_key']
    (seat_hold_id, ordinal) [name: 'idx_hold_passengers_hold_ordinal']
  }

  Note: '''
  Role: Passenger details captured for a temporary hold.
  Passenger email and phone columns are nullable for historical compatibility; active contact flow is stored in booking_contacts as phone country code plus phone number.
  Passenger-to-finalized-seat assignment is represented by payment_attempt_seats.passenger_ordinal at application level, not by a physical FK.
  Named unique constraints:
  - hold_passengers_seat_hold_id_ordinal_key: UNIQUE (seat_hold_id, ordinal)
  - hold_passengers_seat_hold_id_passport_number_key: UNIQUE (seat_hold_id, passport_number)
  PostgreSQL CHECK constraints:
  - hold_passengers_check: CHECK (passport_issue_date IS NULL OR passport_issue_date < passport_expiry_date)
  - hold_passengers_check1: CHECK (emergency_contact_name IS NULL AND emergency_contact_relationship IS NULL AND emergency_contact_phone_country_code IS NULL AND emergency_contact_phone_number IS NULL OR emergency_contact_name IS NOT NULL AND emergency_contact_relationship IS NOT NULL AND emergency_contact_phone_country_code IS NOT NULL AND emergency_contact_phone_number IS NOT NULL AND length(btrim(emergency_contact_name)) > 0 AND length(btrim(emergency_contact_relationship)) > 0 AND emergency_contact_phone_country_code ~ '^\+[1-9][0-9]{0,2}$'::text AND emergency_contact_phone_number ~ '^[0-9]{4,14}$'::text)
  - hold_passengers_email_check: CHECK (length(btrim(email)) > 0)
  - hold_passengers_family_name_check: CHECK (length(btrim(family_name)) > 0)
  - hold_passengers_gender_check: CHECK (gender = ANY (ARRAY['MALE'::text, 'FEMALE'::text, 'UNSPECIFIED'::text]))
  - hold_passengers_given_name_check: CHECK (length(btrim(given_name)) > 0)
  - hold_passengers_middle_name_check: CHECK (middle_name IS NULL OR length(btrim(middle_name)) > 0)
  - hold_passengers_nationality_code_check: CHECK (nationality_code ~ '^[A-Z]{2}$'::text)
  - hold_passengers_ordinal_check: CHECK (ordinal >= 1)
  - hold_passengers_passenger_type_check: CHECK (passenger_type = ANY (ARRAY['ADULT'::text, 'CHILD'::text, 'INFANT'::text]))
  - hold_passengers_passport_issuing_country_code_check: CHECK (passport_issuing_country_code ~ '^[A-Z]{2}$'::text)
  - hold_passengers_passport_number_check: CHECK (passport_number ~ '^[A-Z0-9]{3,20}$'::text)
  - hold_passengers_phone_country_code_check: CHECK (phone_country_code ~ '^\+[1-9][0-9]{0,2}$'::text)
  - hold_passengers_phone_number_check: CHECK (phone_number ~ '^[0-9]{4,14}$'::text)
  - hold_passengers_title_check: CHECK (title = ANY (ARRAY['MR'::text, 'MS'::text, 'MRS'::text, 'MX'::text]))
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - hold_passengers_booking_name_trgm_idx: CREATE INDEX hold_passengers_booking_name_trgm_idx ON public.hold_passengers USING gin (lower((((given_name || ' '::text) || COALESCE((middle_name || ' '::text), ''::text)) || family_name)) gin_trgm_ops)
  '''
}

Table booking_contacts {
  seat_hold_id uuid [pk, not null]
  email text
  preferred_locale text [not null, default: `'EN'::text`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  phone_country_code text
  phone_number text

  Note: '''
  Role: Phone-based booking contact state.
  Active booking contact flow is phone-only; nullable email remains for historical rows.
  PostgreSQL CHECK constraints:
  - booking_contact_phone_complete: CHECK (phone_country_code IS NULL AND phone_number IS NULL OR phone_country_code ~ '^\+[1-9][0-9]{0,2}$'::text AND phone_number ~ '^[0-9]{4,14}$'::text)
  - booking_contacts_email_check: CHECK (length(btrim(email)) > 0)
  - booking_contacts_preferred_locale_check: CHECK (preferred_locale = ANY (ARRAY['EN'::text, 'TH'::text]))
  '''
}

Table hold_review_pricing {
  seat_hold_id uuid [pk, not null]
  source_passenger_details_saved_at timestamptz [not null]
  currency_code text [not null]
  seated_base_fare_unit_amount bigint [not null]
  infant_base_fare_unit_amount bigint [not null]
  base_fare_amount bigint [not null]
  extras_amount bigint [not null]
  demo_passenger_tax_unit_amount bigint [not null]
  taxes_amount bigint [not null]
  demo_airport_fee_unit_amount bigint [not null]
  demo_airport_fee_amount bigint [not null]
  demo_booking_fee_amount bigint [not null]
  fees_amount bigint [not null]
  grand_total_amount bigint [not null]
  priced_at timestamptz [not null, default: `now()`]

  Note: '''
  Role: Authoritative pricing snapshot before payment.
  Pricing is a one-per-hold snapshot; payment_attempts.review_priced_at is a timestamp snapshot, not a physical FK.
  PostgreSQL CHECK constraints:
  - hold_review_pricing_base_fare_amount_check: CHECK (base_fare_amount >= 0)
  - hold_review_pricing_check: CHECK (grand_total_amount = (base_fare_amount + extras_amount + taxes_amount + fees_amount))
  - hold_review_pricing_check1: CHECK (fees_amount = (demo_airport_fee_amount + demo_booking_fee_amount))
  - hold_review_pricing_currency_code_check: CHECK (currency_code ~ '^[A-Z]{3}$'::text)
  - hold_review_pricing_demo_airport_fee_amount_check: CHECK (demo_airport_fee_amount >= 0)
  - hold_review_pricing_demo_airport_fee_unit_amount_check: CHECK (demo_airport_fee_unit_amount >= 0)
  - hold_review_pricing_demo_booking_fee_amount_check: CHECK (demo_booking_fee_amount >= 0)
  - hold_review_pricing_demo_passenger_tax_unit_amount_check: CHECK (demo_passenger_tax_unit_amount >= 0)
  - hold_review_pricing_extras_amount_check: CHECK (extras_amount >= 0)
  - hold_review_pricing_fees_amount_check: CHECK (fees_amount >= 0)
  - hold_review_pricing_grand_total_amount_check: CHECK (grand_total_amount >= 0)
  - hold_review_pricing_infant_base_fare_unit_amount_check: CHECK (infant_base_fare_unit_amount = 0)
  - hold_review_pricing_seated_base_fare_unit_amount_check: CHECK (seated_base_fare_unit_amount > 0)
  - hold_review_pricing_taxes_amount_check: CHECK (taxes_amount >= 0)
  '''
}

Table payment_attempts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  seat_hold_id uuid [not null]
  request_id uuid [not null]
  request_fingerprint bytea [not null]
  provider text [not null]
  payment_method text [not null]
  status text [not null]
  amount bigint [not null]
  currency_code text [not null]
  review_priced_at timestamptz [not null]
  provider_reference text
  failure_code text
  failure_message text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  succeeded_at timestamptz
  payment_finalization_deadline timestamptz

  indexes {
    (seat_hold_id, request_id) [unique, name: 'payment_attempts_seat_hold_id_request_id_key']
    (seat_hold_id, created_at) [name: 'idx_payment_attempts_hold_created']
  }

  Note: '''
  Role: Durable payment-attempt state.
  Current providers are Stripe Test Mode and Mock Bitcoin, enforced by PostgreSQL CHECK constraints.
  Ticket issuance is downstream of successful payment and inventory finalization.
  PostgreSQL function (not a table/Ref): public.has_protected_stripe_card_finalization(uuid) RETURNS boolean, STABLE, PARALLEL SAFE.
  Named unique constraints:
  - payment_attempts_seat_hold_id_request_id_key: UNIQUE (seat_hold_id, request_id)
  PostgreSQL CHECK constraints:
  - payment_attempts_amount_check: CHECK (amount > 0)
  - payment_attempts_check1: CHECK ((status = 'SUCCEEDED'::text) = (succeeded_at IS NOT NULL))
  - payment_attempts_check2: CHECK ((status = ANY (ARRAY['FAILED'::text, 'CANCELLED'::text])) = (failure_code IS NOT NULL AND failure_message IS NOT NULL))
  - payment_attempts_currency_code_check: CHECK (currency_code ~ '^[A-Z]{3}$'::text)
  - payment_attempts_finalization_reservation_check: CHECK ((provider = 'STRIPE'::text AND payment_method = 'CARD'::text) = (payment_finalization_deadline IS NOT NULL))
  - payment_attempts_payment_method_check: CHECK (payment_method = ANY (ARRAY['CARD'::text, 'BITCOIN'::text]))
  - payment_attempts_provider_check: CHECK (provider = ANY (ARRAY['STRIPE'::text, 'MOCK_BITCOIN'::text]))
  - payment_attempts_provider_payment_method_check: CHECK (provider = 'STRIPE'::text AND payment_method = 'CARD'::text OR provider = 'MOCK_BITCOIN'::text AND payment_method = 'BITCOIN'::text)
  - payment_attempts_request_fingerprint_check: CHECK (octet_length(request_fingerprint) = 32)
  - payment_attempts_status_check: CHECK (status = ANY (ARRAY['CREATED'::text, 'PROCESSING'::text, 'AWAITING_PAYMENT'::text, 'SUCCEEDED'::text, 'FAILED'::text, 'CANCELLED'::text]))
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - idx_payment_attempts_executive_analytics: CREATE INDEX idx_payment_attempts_executive_analytics ON public.payment_attempts USING btree (provider, succeeded_at, seat_hold_id) INCLUDE (amount) WHERE ((status = 'SUCCEEDED'::text) AND (currency_code = 'THB'::text))
  - idx_payment_attempts_hold_created: CREATE INDEX idx_payment_attempts_hold_created ON public.payment_attempts USING btree (seat_hold_id, created_at DESC)
  - idx_payment_attempts_one_open_per_hold: CREATE UNIQUE INDEX idx_payment_attempts_one_open_per_hold ON public.payment_attempts USING btree (seat_hold_id) WHERE (status = ANY (ARRAY['CREATED'::text, 'PROCESSING'::text, 'AWAITING_PAYMENT'::text]))
  - idx_payment_attempts_one_success_per_hold: CREATE UNIQUE INDEX idx_payment_attempts_one_success_per_hold ON public.payment_attempts USING btree (seat_hold_id) WHERE (status = 'SUCCEEDED'::text)
  - idx_payment_attempts_protected_stripe_finalization: CREATE INDEX idx_payment_attempts_protected_stripe_finalization ON public.payment_attempts USING btree (seat_hold_id) WHERE ((provider = 'STRIPE'::text) AND (payment_method = 'CARD'::text) AND (status = ANY (ARRAY['CREATED'::text, 'PROCESSING'::text, 'AWAITING_PAYMENT'::text])) AND (payment_finalization_deadline IS NOT NULL))
  - idx_payment_attempts_stripe_reference: CREATE UNIQUE INDEX idx_payment_attempts_stripe_reference ON public.payment_attempts USING btree (provider_reference) WHERE ((provider = 'STRIPE'::text) AND (provider_reference IS NOT NULL))
  '''
}

Table payment_attempt_seats {
  payment_attempt_id uuid [not null]
  flight_seat_id uuid [not null]
  released_at timestamptz
  passenger_ordinal smallint [not null]

  indexes {
    (payment_attempt_id, flight_seat_id) [pk, name: 'payment_attempt_seats_pkey']
    (payment_attempt_id, passenger_ordinal) [unique, name: 'payment_attempt_seats_attempt_passenger_unique']
  }

  Note: '''
  Role: Durable finalized payment-to-seat association.
  Passenger ordinal is application-level association metadata; no physical FK to hold_passengers exists.
  Named unique constraints:
  - payment_attempt_seats_attempt_passenger_unique: UNIQUE (payment_attempt_id, passenger_ordinal)
  PostgreSQL CHECK constraints:
  - payment_attempt_seats_passenger_ordinal_positive: CHECK (passenger_ordinal > 0)
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - payment_attempt_seats_one_active_owner_idx: CREATE UNIQUE INDEX payment_attempt_seats_one_active_owner_idx ON public.payment_attempt_seats USING btree (flight_seat_id) WHERE (released_at IS NULL)
  '''
}

Table tickets {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  payment_attempt_id uuid [not null, unique]
  booking_reference text [not null, unique]
  ticket_number text [not null, unique]
  status text [not null]
  issued_at timestamptz [not null, default: `now()`]
  cancelled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    booking_reference [name: 'idx_tickets_booking_reference']
    (created_at, booking_reference) [name: 'tickets_booking_management_order_idx']
  }

  Note: '''
  Role: Durable commercial ticket record.
  Customer recovery uses Booking Reference plus Last Name in application logic; this schema has no customer account.
  Ticket links physically to payment_attempts; passenger and finalized-seat history are reached through the application join path.
  Named unique constraints:
  - tickets_booking_reference_key: UNIQUE (booking_reference)
  - tickets_payment_attempt_id_key: UNIQUE (payment_attempt_id)
  - tickets_ticket_number_key: UNIQUE (ticket_number)
  PostgreSQL CHECK constraints:
  - tickets_booking_reference_check: CHECK (booking_reference ~ '^XF[A-Z2-9]{8}$'::text)
  - tickets_check: CHECK ((status = 'CANCELLED'::text) = (cancelled_at IS NOT NULL))
  - tickets_status_check: CHECK (status = ANY (ARRAY['ISSUED'::text, 'CANCELLED'::text]))
  - tickets_ticket_number_check: CHECK (ticket_number ~ '^XFT[A-Z2-9]{12}$'::text)
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - tickets_booking_management_order_idx: CREATE INDEX tickets_booking_management_order_idx ON public.tickets USING btree (created_at DESC, booking_reference)
  '''
}

Table booking_cancellations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  ticket_id uuid [not null, unique]
  payment_attempt_id uuid [not null, unique]
  refund_provider text [not null]
  refund_status text [not null, default: `'PENDING'::text`]
  refund_amount bigint [not null]
  currency_code text [not null]
  provider_refund_id text
  attempt_count smallint [not null, default: 0]
  next_attempt_at timestamptz [not null, default: `now()`]
  lease_until timestamptz
  lease_token uuid
  last_error_code text
  requested_at timestamptz [not null]
  cancelled_at timestamptz [not null]
  refunded_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Role: Durable cancellation and refund state.
  Cancellation and refund history remains durable and separate from ticket/payment lifecycle state.
  Named unique constraints:
  - booking_cancellations_payment_attempt_id_key: UNIQUE (payment_attempt_id)
  - booking_cancellations_ticket_id_key: UNIQUE (ticket_id)
  PostgreSQL CHECK constraints:
  - booking_cancellations_attempt_count_check: CHECK (attempt_count >= 0 AND attempt_count <= 6)
  - booking_cancellations_check: CHECK ((refund_status = 'IN_FLIGHT'::text) = (lease_until IS NOT NULL AND lease_token IS NOT NULL))
  - booking_cancellations_check1: CHECK ((refund_status = 'SUCCEEDED'::text) = (refunded_at IS NOT NULL))
  - booking_cancellations_currency_code_check: CHECK (currency_code ~ '^[A-Z]{3}$'::text)
  - booking_cancellations_refund_amount_check: CHECK (refund_amount > 0)
  - booking_cancellations_refund_provider_check: CHECK (refund_provider = ANY (ARRAY['STRIPE'::text, 'MOCK_BITCOIN'::text]))
  - booking_cancellations_refund_status_check: CHECK (refund_status = ANY (ARRAY['PENDING'::text, 'IN_FLIGHT'::text, 'PROCESSING'::text, 'SUCCEEDED'::text, 'REQUIRES_ATTENTION'::text]))
  PostgreSQL indexes represented by notes because DBML cannot preserve their predicate, expression, or advanced definition exactly:
  - booking_cancellations_due_idx: CREATE INDEX booking_cancellations_due_idx ON public.booking_cancellations USING btree (next_attempt_at, created_at) WHERE (refund_status = ANY (ARRAY['PENDING'::text, 'PROCESSING'::text, 'IN_FLIGHT'::text]))
  - booking_cancellations_provider_refund_unique_idx: CREATE UNIQUE INDEX booking_cancellations_provider_refund_unique_idx ON public.booking_cancellations USING btree (refund_provider, provider_refund_id) WHERE (provider_refund_id IS NOT NULL)
  '''
}

